{
  "id": "finance",
  "name": "Finance model",
  "audience": "An investment committee or FP&A reader checking a case.",
  "deliverables": [
    "Integrated model",
    "Returns page",
    "Assumption log"
  ],
  "page": {
    "pptx": {
      "width_in": 13.3333333333,
      "height_in": 7.5,
      "margin_in": 0.58
    },
    "docx": {
      "paper": "A4",
      "margins_mm": {
        "top": 25,
        "bottom": 22,
        "left": 25,
        "right": 25
      }
    },
    "pdf": {
      "paper": "a4",
      "margins_mm": {
        "top": 22,
        "bottom": 22,
        "left": 24,
        "right": 24
      }
    },
    "xlsx": {
      "paper": "A3"
    }
  },
  "type": {
    "pptx": {
      "latin": "Liberation Sans",
      "ea": "Noto Sans CJK SC",
      "mono": "Liberation Mono"
    },
    "docx": {
      "latin": "Liberation Sans",
      "ea": "Noto Sans CJK SC",
      "body_pt": 11
    },
    "xlsx": {
      "latin": "Liberation Sans",
      "ea": "Noto Sans CJK SC"
    },
    "pdf": {
      "latin": "Liberation Serif",
      "ea": "Noto Serif CJK SC",
      "sans": "Liberation Sans",
      "ea_sans": "Noto Sans CJK SC",
      "body_pt": 11,
      "heading_pt": 14,
      "justify": true,
      "first_line_indent_em": 0,
      "number_headings": true
    },
    "scale": {
      "cover_title": 34,
      "cover_sub": 16,
      "kicker": 13,
      "action_title": 20,
      "section_title": 32,
      "close_title": 28,
      "body": 14,
      "insight": 14,
      "pull": 18,
      "table": 12,
      "caption": 12,
      "source": 10
    }
  },
  "palette": {
    "ink": "1C1C1C",
    "paper": "FFFFFF",
    "muted": "5F5F5F",
    "line": "D0D0D0",
    "accent": "1F4E79",
    "mark": "1F4E79",
    "dark": "1C1C1C",
    "on_dark": "F5F5F5",
    "on_dark_muted": "C8C8C8",
    "negative": "9C2F2F",
    "series": [
      "1C1C1C",
      "1F4E79",
      "7A7A7A",
      "B4B4B4"
    ],
    "dominance": "Black, white, and one steel blue. Model colors (blue input, yellow assumption, green cross-sheet) are grammar, not decoration."
  },
  "labels": {
    "zh": {
      "illustrative": "示意",
      "recommend": "建议",
      "source": "资料"
    },
    "en": {
      "illustrative": "Illustrative",
      "recommend": "Recommend",
      "source": "Source"
    }
  },
  "tones": {
    "cover": "dark",
    "section": "dark",
    "close": "dark",
    "content": "light"
  },
  "model": {
    "input_font": "0000FF",
    "formula_font": "000000",
    "cross_font": "008000",
    "input_fill": "FFFF99",
    "external_font": "FF0000"
  },
  "primitives": [
    "cover",
    "section",
    "action",
    "chart",
    "table",
    "matrix",
    "timeline",
    "comparison",
    "steps",
    "close"
  ],
  "data_policy": {
    "invent_precise_statistics": false,
    "illustrative_label_required": true,
    "rule": "Every hardcoded number is an assumption with a source note. Totals, NPV, and IRR are formulas. Years are text. No XLOOKUP."
  }
}
